# Examples only. Server scripts read process environment variables, not this file.
# The local frontend uses the VPS through an HTTPS proxy by default; no workspace switch is needed.
# Production uses the same-origin API. VITE_API_BASE_URL is optional and must contain no secrets.
# JOYNO_API_PROXY_TARGET=https://joynoadmin.tech
# JOYNO_VPS_TUNNEL_URL=http://127.0.0.1:3002
JOYNO_DB_DRIVER=sqlite
JOYNO_API_PORT=3001
JOYNO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL alternative (server-only variables; never prefix database secrets with VITE_).
# JOYNO_DB_DRIVER=postgres
# JOYNO_DB_HOST=127.0.0.1
# JOYNO_DB_PORT=5432
# JOYNO_DB_NAME=joyno
# JOYNO_DB_USER=joyno_app
# JOYNO_DB_PASSWORD=replace-with-a-strong-password
# JOYNO_DATABASE_SSL=true
# JOYNO_DATABASE_CA=/absolute/path/to/trusted-ca.pem

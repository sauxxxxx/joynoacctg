# Copy to .env beside compose.yaml. Keep it out of Git; chmod 600 .env.
# Use two different randomly generated passwords. Single-quote values containing $ or #.
JOYNO_OWNER_DB_PASSWORD='replace-with-a-long-random-owner-password'
JOYNO_APP_DB_PASSWORD='replace-with-a-different-long-random-runtime-password'
JOYNO_HOST_API_PORT=3001
JOYNO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
